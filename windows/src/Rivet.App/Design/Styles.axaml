<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Text ─────────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizePanelRow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
  </Style>

  <!-- ── Surfaces ─────────────────────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill.beta">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────────────── -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RowCornerRadius}" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowPressedBrush}" />
  </Style>
  <Style Selector="Button.footer">
    <Setter Property="Background" Value="{DynamicResource PanelCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.recorder">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.sidebar">
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Button.sidebar.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
  </Style>
  <Style Selector="Button.sidebar.selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ── Tabs in the panel header ─────────────────────────────────── -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Chrome" Background="Transparent" CornerRadius="6" Height="32" Padding="0">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#Chrome">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#Chrome">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ── Compact switches (no On/Off text) ────────────────────────── -->
  <Style Selector="ToggleSwitch.compact">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
