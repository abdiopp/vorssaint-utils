<!--
  Design tokens (spec 05 §4), adapted for Windows 11 legibility. Accent comes
  from the Fluent theme (SystemAccentColor follows the Windows accent).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="TextPrimaryColor">#E4000000</Color>
      <Color x:Key="TextSecondaryColor">#9E000000</Color>
      <Color x:Key="TextTertiaryColor">#72000000</Color>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

      <!-- Flyout panel -->
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F9F9F9" />
      <SolidColorBrush x:Key="PanelTintBrush" Color="#B0FFFFFF" />
      <SolidColorBrush x:Key="PanelBorderBrush" Color="#17000000" />
      <SolidColorBrush x:Key="PanelCardBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="PanelCardBorderBrush" Color="#12000000" />
      <SolidColorBrush x:Key="PanelControlBrush" Color="#0E000000" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="RowPressedBrush" Color="#18000000" />
      <SolidColorBrush x:Key="SeparatorBrush" Color="#14000000" />
      <SolidColorBrush x:Key="ChipBrush" Color="#12000000" />

      <!-- Settings window -->
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SettingsCardBrush" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="HudBackgroundBrush" Color="#F2FBFBFB" />

      <!-- Semantic metric colours, darkened for contrast on light backgrounds -->
      <SolidColorBrush x:Key="MetricGreenBrush" Color="#00702E" />
      <SolidColorBrush x:Key="MetricCyanBrush" Color="#006E8A" />
      <SolidColorBrush x:Key="MetricMintBrush" Color="#007066" />
      <SolidColorBrush x:Key="MetricYellowBrush" Color="#8F5C00" />
      <SolidColorBrush x:Key="MetricRedBrush" Color="#AD141A" />
      <SolidColorBrush x:Key="MetricOrangeBrush" Color="#AD4D00" />
      <SolidColorBrush x:Key="MetricPinkBrush" Color="#AD0F57" />
      <SolidColorBrush x:Key="MetricPurpleBrush" Color="#7A3DB8" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
      <Color x:Key="TextSecondaryColor">#C5FFFFFF</Color>
      <Color x:Key="TextTertiaryColor">#87FFFFFF</Color>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="PanelTintBrush" Color="#9A202020" />
      <SolidColorBrush x:Key="PanelBorderBrush" Color="#1CFFFFFF" />
      <SolidColorBrush x:Key="PanelCardBrush" Color="#10FFFFFF" />
      <SolidColorBrush x:Key="PanelCardBorderBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="PanelControlBrush" Color="#16FFFFFF" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#10FFFFFF" />
      <SolidColorBrush x:Key="RowPressedBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="SeparatorBrush" Color="#18FFFFFF" />
      <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF" />

      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="SettingsCardBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#19000000" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="HudBackgroundBrush" Color="#F02B2B2B" />

      <SolidColorBrush x:Key="MetricGreenBrush" Color="#32D74B" />
      <SolidColorBrush x:Key="MetricCyanBrush" Color="#64D2FF" />
      <SolidColorBrush x:Key="MetricMintBrush" Color="#63E6E2" />
      <SolidColorBrush x:Key="MetricYellowBrush" Color="#FFD60A" />
      <SolidColorBrush x:Key="MetricRedBrush" Color="#FF453A" />
      <SolidColorBrush x:Key="MetricOrangeBrush" Color="#FF9F0A" />
      <SolidColorBrush x:Key="MetricPinkBrush" Color="#FF375F" />
      <SolidColorBrush x:Key="MetricPurpleBrush" Color="#BF5AF2" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Accent-derived fills (opacity over the system accent) -->
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="AccentFaintBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.10" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F7630C" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#F7630C" Opacity="0.16" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />

  <!-- Sizes -->
  <x:Double x:Key="PanelWidth">340</x:Double>
  <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="RowCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">10</CornerRadius>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizePanelRow">13</x:Double>
  <x:Double x:Key="FontSizeCardTitle">14</x:Double>
  <x:Double x:Key="FontSizePageTitle">24</x:Double>
  <x:Double x:Key="FontSizeSectionTitle">11</x:Double>
</ResourceDictionary>
